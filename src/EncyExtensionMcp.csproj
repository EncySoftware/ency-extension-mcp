<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EncyExtensionMcp</RootNamespace>
    <AssemblyName>ency-extension-mcp</AssemblyName>

    <!-- dotnet tool packaging: `dotnet pack` builds the tool nupkg; install it globally
         from a feed (see README for the exact command) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ency-extension-mcp</ToolCommandName>
    <PackageId>EncySoftware.ExtensionStoreMcp</PackageId>
    <Version>0.1.13</Version>
    <Authors>EncySoftware</Authors>
    <Description>MCP server for Cursor: create, publish and track ENCY extensions in the ENCY Extension Store</Description>
    <PackageProjectUrl>https://github.com/EncySoftware/ency-extension-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EncySoftware/ency-extension-mcp</RepositoryUrl>
    <!-- Shown on the nuget.org listing page; without a readme the page is just the one-line
         description, which tells an author nothing about the setup. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Same terms as the other EncySoftware packages on nuget.org (the SDK ships this same file). -->
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageTags>ency;encycam;cam;mcp;model-context-protocol;extensions;dotnet-tool;cursor</PackageTags>
  </PropertyGroup>

  <!-- Tests exercise internal helpers (publisher bootstrap) without widening the tool surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="EncyExtensionMcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <!-- The extension-type skill library travels inside the assembly, so get_extension_guide works
       offline and ships with the tool version. Same files feed tools/sync-rules.ps1. -->
  <ItemGroup>
    <EmbeddedResource Include="..\guides\*.md" LogicalName="EncyExtensionMcp.guides.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\guides\_index.json" LogicalName="EncyExtensionMcp.guides._index.json" />
  </ItemGroup>
</Project>
